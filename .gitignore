# --- Environnement Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Secrets : JAMAIS dans le dépôt (exigence du guide) ---
.env

# --- Logs d'exécution ---
logs/*.log

# --- Données : régénérées par le pipeline ---
data/*/*/*

# Conserver les dossiers vides
!data/*/*/.gitkeep

# Conserver uniquement l'échantillon RAW de démonstration
!data/raw/weather/sample_open_meteo_paris_20261107_153258.json

# --- Rapports générés ---
reports/*.json

# Rapports générés dans les sous-dossiers
reports/**/*.json
